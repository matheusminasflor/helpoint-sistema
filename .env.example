# Copie para `.env` e preencha com o projeto Supabase do SEU ambiente.
#
# Todas as chaves aqui sao *publishable* — vao para o navegador e nao sao
# segredo. A chave `service_role` NUNCA entra neste arquivo: ela vive nos
# secrets das edge functions e no Vault do Postgres (docs/ambientes.md).
#
# Projetos (nome do painel  ref):
#   test-helpoint      gmvvxulubthkagmsngas  <- desenvolvimento e testes
#   helpoint-producao  joafqgmiirggohxkomrl  <- producao; nunca alvo de dev

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>

# A empresa deste ambiente (ADR-010: o Helpoint e de uma empresa so).
# Serve para a tela de login mostrar a marca — logo, banner e mensagem de
# boas-vindas configurados em Configuracoes > Marca — ANTES de alguem entrar.
# Sem isto o login aparece sem marca; nada quebra.
# No test-helpoint sao duas empresas: `helpoint` ou `minasflor-professional`.
VITE_TENANT_SLUG=minasflor-professional

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon key>
