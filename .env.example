# Copie para `.env` e preencha com o projeto Supabase do SEU ambiente.
#
# Todas as chaves aqui sao *publishable* — elas vao para o bundle do navegador
# e nao sao segredo. A chave `service_role` NUNCA entra neste arquivo: ela vive
# so nos secrets das edge functions, no painel do Supabase.
#
# Ambientes:
#   test-helpoint  gmvvxulubthkagmsngas  <- desenvolvimento e testes
#   producao       joafqgmiirggohxkomrl  <- zerado ate o deploy
#   lovable        csbhhvgnbpleinxlpkcd  <- sistema em producao, dados reais.
#                                           NAO apontar ambiente de dev para ca.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon key>
